# Tether: web UI over every Claude Code chat on this machine.
# Generated by install.sh from deploy/tether.service; re-run it to change.
[Unit]
Description=Tether (Claude Code web UI joined to the daemon's jobs)
After=network-online.target claude-daemon.service
Wants=network-online.target

[Service]
User=@RUN_USER@
WorkingDirectory=@INSTALL_DIR@
Environment=HOME=@RUN_HOME@
Environment=PATH=@PATH@:/usr/bin:/bin
Environment=NODE_ENV=production
# Tether's own long-lived Claude token (claude setup-token), if saved.
ExecStart=/bin/sh -c '[ -r @TOKEN_FILE@ ] && export CLAUDE_CODE_OAUTH_TOKEN="$(cat @TOKEN_FILE@)"; exec /usr/bin/env node dist-server/server/index.js'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
