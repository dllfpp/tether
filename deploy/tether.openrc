#!/sbin/openrc-run
# Tether: web UI over every Claude Code chat on this machine.
# Generated by install.sh from deploy/tether.openrc; re-run it to change.

name="tether"
description="Tether (Claude Code web UI joined to the daemon's jobs)"

supervisor="supervise-daemon"
command="/usr/bin/node"
command_args="@INSTALL_DIR@/dist-server/server/index.js"
command_user="@RUN_USER@"
directory="@INSTALL_DIR@"
output_log="/var/log/tether.log"
error_log="/var/log/tether.log"
respawn_delay=5
respawn_max=0

# PATH is extended, never replaced: openrc-run keeps its helpers on it.
export HOME="@RUN_HOME@"
export PATH="@PATH@:${PATH}"
export NODE_ENV=production

depend() {
    need net
    after firewall claude-daemon
}

start_pre() {
    checkpath -f -m 0640 -o "@RUN_USER@" /var/log/tether.log
    # Tether's own long-lived Claude token (claude setup-token), if saved.
    if [ -r "@TOKEN_FILE@" ]; then
        CLAUDE_CODE_OAUTH_TOKEN="$(cat "@TOKEN_FILE@")"
        export CLAUDE_CODE_OAUTH_TOKEN
    fi
}
