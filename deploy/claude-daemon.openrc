#!/sbin/openrc-run
# Claude Code daemon (background jobs), kept up across reboots.
# Generated by Tether's install.sh from deploy/claude-daemon.openrc.

name="claude-daemon"
description="Claude Code daemon"

supervisor="supervise-daemon"
command="@CLAUDE_BIN@"
command_args="daemon run"
command_user="@RUN_USER@"
directory="@RUN_HOME@"
output_log="/var/log/claude-daemon.log"
error_log="/var/log/claude-daemon.log"
respawn_delay=5

export HOME="@RUN_HOME@"
export PATH="$(dirname "@CLAUDE_BIN@"):/usr/local/bin:${PATH}"

depend() {
    need net
}

start_pre() {
    checkpath -f -m 0640 -o "@RUN_USER@" /var/log/claude-daemon.log
    if [ -r "@TOKEN_FILE@" ]; then
        CLAUDE_CODE_OAUTH_TOKEN="$(cat "@TOKEN_FILE@")"
        export CLAUDE_CODE_OAUTH_TOKEN
    fi
    # A daemon started on demand may hold the socket: hand over, keep the jobs.
    "@CLAUDE_BIN@" daemon stop --any --keep-workers >/dev/null 2>&1 || true
}
