# Claude Code daemon (background jobs), kept up across reboots.
# Generated by Tether's install.sh from deploy/claude-daemon.service.
[Unit]
Description=Claude Code daemon
After=network-online.target
Wants=network-online.target

[Service]
User=@RUN_USER@
WorkingDirectory=@RUN_HOME@
Environment=HOME=@RUN_HOME@
Environment=PATH=@PATH@:/usr/bin:/bin
ExecStartPre=-@CLAUDE_BIN@ daemon stop --any --keep-workers
ExecStart=/bin/sh -c '[ -r @TOKEN_FILE@ ] && export CLAUDE_CODE_OAUTH_TOKEN="$(cat @TOKEN_FILE@)"; exec @CLAUDE_BIN@ daemon run'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
